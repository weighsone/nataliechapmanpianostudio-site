# Formbricks configuration — https://forms.jono.rocks
# Copy this file to .env and fill in values from your Formbricks dashboard.
# For GitHub Actions (production), set these as repository variables (Settings → Variables).

# From: Settings → General → Environment ID
PUBLIC_FORMBRICKS_ENV_ID=your_environment_id

# From: the URL when editing your contact survey (/environments/{envId}/surveys/{surveyId})
PUBLIC_FORMBRICKS_SURVEY_ID=your_survey_id

# Question IDs — found by clicking each question in the survey editor
PUBLIC_FB_Q_NAME=your_name_question_id
PUBLIC_FB_Q_PHONE=your_phone_question_id
PUBLIC_FB_Q_EMAIL=your_email_question_id
PUBLIC_FB_Q_STUDENT=your_student_name_question_id
PUBLIC_FB_Q_SUBJECT=your_subject_question_id
PUBLIC_FB_Q_MESSAGE=your_message_question_id
