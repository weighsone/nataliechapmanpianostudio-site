---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;

const apps = [
  {
    name: 'Note Rush',
    url: 'https://www.noterushapp.com/',
    icon: '/images/app-note-rush.png',
    description: 'A fun and effective game for practising note reading on the music staff. Works across multiple instruments.',
    platforms: ['iOS', 'Android'],
    category: 'Note Reading & Theory',
  },
  {
    name: 'Flashnote Derby',
    url: 'https://flashnotederby.com/',
    icon: '/images/app-flashnote-derby.png',
    description: 'Turns note memorisation into a fun and challenging game - race horses by identifying notes correctly!',
    platforms: ['iOS', 'Android'],
    category: 'Note Reading & Theory',
  },
  {
    name: 'Rhythm Swing',
    url: 'https://rhythmswing.com/',
    icon: '/images/app-rhythm-swing.png',
    description: 'Teaches rhythm notation through interactive gameplay. Great for building a solid rhythmic foundation.',
    platforms: ['iPad', 'iPhone'],
    category: 'Note Reading & Theory',
  },
  {
    name: 'The Piano',
    url: 'https://apps.apple.com/us/app/piano/id1126477246',
    icon: '/images/app-the-piano.png',
    description: 'A free portable keyboard app - handy for when you are away from your piano and want to practise fingering or check a note.',
    platforms: ['iOS'],
    category: 'General Music',
  },
  {
    name: 'MuseScore',
    url: 'https://musescore.org/en',
    icon: '/images/app-musescore.png',
    description: 'An excellent open-source library of sheet music with new pieces added daily. The free version gives access to thousands of scores.',
    platforms: ['iOS', 'Android', 'Desktop'],
    category: 'General Music',
  },
  {
    name: 'The Most Amazing Sheep Game',
    url: 'https://apps.apple.com/nz/app/the-most-amazing-sheep-game/id550921301',
    icon: '/images/app-sheep-game.png',
    description: 'Rhythm and beat training disguised as entertainment. Surprisingly effective for building a sense of pulse.',
    platforms: ['iOS'],
    category: 'General Music',
  },
];

const retailers = [
  { name: 'Rockshop', url: 'https://www.rockshop.co.nz', note: 'Wide range of instruments and accessories' },
  { name: 'Piano Traders', url: 'https://www.pianotraders.co.nz', note: 'New and used pianos, specialist advice' },
  { name: 'KBB Music', url: 'https://www.kbbmusic.co.nz', note: 'Sheet music, instruments, and accessories' },
  { name: 'Music Planet', url: 'https://www.musicplanet.co.nz', note: 'Instruments and accessories' },
  { name: 'Musicworks', url: 'https://www.musicworks.co.nz', note: 'Nationwide music retailer' },
  { name: 'Trade Me', url: 'https://www.trademe.co.nz', note: 'Second-hand instruments - great for budget buyers' },
];

const sheetMusic = [
  { name: 'KBB Music', url: 'https://www.kbbmusic.co.nz', type: 'Local' },
  { name: 'Piano Traders', url: 'https://www.pianotraders.co.nz', type: 'Local' },
  { name: 'Fishpond', url: 'https://www.fishpond.co.nz', type: 'Online NZ' },
  { name: 'Book Depository', url: 'https://www.bookdepository.com', type: 'Online International' },
];

const appCategories = [...new Set(apps.map(a => a.category))];
---

<Layout
  title="Resources"
  description="Recommended apps, instrument retailers, and sheet music suppliers for piano students at Natalie Chapman Piano Studio."
>

  <!-- Page Header -->
  <section class="relative overflow-hidden text-white py-16 md:py-24">
    <div class="fixed inset-0 -z-10">
      <Image
        src={u('/images/sheet-music-header.jpg')}
        alt=""
        width={1920}
        height={1440}
        class="w-full h-full object-cover object-[50%_60%]"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-black/30"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">Helpful Links</p>
        <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">Resources</h1>
        <p class="text-white/90 max-w-xl mx-auto leading-relaxed">
          Apps, instrument retailers, and sheet music sources recommended for students at the studio.
        </p>
      </div>
    </div>
  </section>

  <!-- Apps -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">Practice Tools</p>
        <h2 class="font-display text-3xl font-bold text-ink mb-4">Recommended Apps</h2>
        <p class="text-ink-muted max-w-2xl leading-relaxed">
          These apps make practising between lessons more enjoyable. Games and interactive tools can reinforce note reading and rhythm skills in a fun way.
        </p>
      </div>

      {appCategories.map(category => (
        <div class="mb-10">
          <h3 class="text-sm font-semibold text-ink-muted uppercase tracking-widest mb-4 pb-2 border-b border-linen">
            {category}
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {apps.filter(a => a.category === category).map(app => (
              <a href={app.url} target="_blank" rel="noopener noreferrer" class="bg-white rounded-xl border border-linen p-5 flex flex-col hover:border-brand hover:shadow-sm transition-all group">
                <div class="flex items-start gap-4 mb-3">
                  <Image
                    src={u(app.icon)}
                    alt={`${app.name} icon`}
                    width={56}
                    height={56}
                    class="w-14 h-14 rounded-xl object-cover shrink-0 border border-linen"
                  />
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-ink group-hover:text-brand transition-colors leading-tight mb-1">{app.name}</h4>
                    <div class="flex flex-wrap gap-1">
                      {app.platforms.map(p => (
                        <span class="text-[10px] font-medium bg-brand-light text-brand px-2 py-0.5 rounded-full">
                          {p}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
                <p class="text-sm text-ink-muted leading-relaxed">{app.description}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Instrument Retailers -->
  <section class="bg-cream-dark py-16 border-y border-linen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <div>
          <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">Where to Buy</p>
          <h2 class="font-display text-3xl font-bold text-ink mb-4">Instrument Retailers</h2>
          <p class="text-ink-muted leading-relaxed mb-8">
            New Zealand suppliers for digital pianos, keyboards, and accessories. For beginners, a digital keyboard with weighted keys is a great starting point. Ask me for specific recommendations at any time.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {retailers.map(r => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white rounded-xl border border-linen p-4 flex items-start gap-3 hover:border-brand hover:shadow-sm transition-all group"
              >
                <div class="w-8 h-8 rounded-lg bg-brand-light flex items-center justify-center shrink-0 group-hover:bg-brand transition-colors">
                  <svg class="w-4 h-4 text-brand group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-ink text-sm group-hover:text-brand transition-colors">{r.name}</p>
                  <p class="text-xs text-ink-muted">{r.note}</p>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-xl" style="max-height: 520px;">
          <Image
            src={u('/images/resources-piano.jpg')}
      width=690
      height=920
            alt="Music instrument store"
            class="w-full h-full object-cover object-center"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Sheet Music -->
  <section class="bg-white py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <div class="rounded-2xl overflow-hidden shadow-xl order-2 lg:order-1" style="max-height: 460px;">
          <Image
            src={u('/images/resources-pianist.jpg')}
      width=690
      height=1035
            alt="Sheet music open on a piano"
            class="w-full h-full object-cover object-top"
          />
        </div>

        <div class="order-1 lg:order-2">
          <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">Sheet Music</p>
          <h2 class="font-display text-3xl font-bold text-ink mb-4">Where to Find Sheet Music</h2>
          <p class="text-ink-muted leading-relaxed mb-8">
            Method books and sheet music are available both locally and online. Note that online international orders may have longer delivery times - plan ahead for method books in particular.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {sheetMusic.map(s => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white rounded-xl border border-linen p-5 hover:border-brand hover:shadow-sm transition-all group"
              >
                <p class="font-semibold text-ink group-hover:text-brand transition-colors mb-1">{s.name}</p>
                <p class="text-xs text-ink-muted">{s.type}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
