---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;

const testimonials = [
  {
    quote: 'She has always been very flexible around lessons so that it fits in with our busy lives.',
    name: 'Suyen',
    role: 'Parent',
  },
  {
    quote: 'My son always comes home after a lesson buzzing - I wish I could say the same about school!',
    name: 'Heidi',
    role: 'Parent',
  },
  {
    quote: 'She makes learning the piano fun and uncomplicated.',
    name: 'Jasper',
    role: 'Student',
  },
  {
    quote: 'She proactively finds ways to engage her students by exploring their interests.',
    name: 'Carmela',
    role: 'Parent',
  },
];

const differentiators = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`,
    title: 'Tailored to You',
    body: 'No one-size-fits-all approach here. Every lesson is designed around your goals, learning style, and musical interests.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />`,
    title: 'Your Style of Music',
    body: "Classical, pop, jazz, church band - we follow your passion. Loving what you play is the best motivator.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    title: 'Flexible Scheduling',
    body: 'Life is busy. Lessons fit around your family, work, and commitments - not the other way around.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    title: 'Positive & Encouraging',
    body: 'Music should be joyful. The studio is a warm, pressure-free space where every student feels celebrated.',
  },
];
---

<Layout title="Home" description="Creative, flexible and fun piano lessons in Orewa, Auckland. All ages and levels welcome. Book a lesson with Natalie Chapman today.">

  <!-- Hero -->
  <section class="relative overflow-hidden text-white pb-16 md:pb-0">
    <div class="fixed inset-0 -z-10">
      <Image
        src={u('/images/piano-hero.jpg')}
        alt=""
        width={1920}
        height={1440}
        class="object-cover object-center"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-black/30"></div>
    </div>

    <div class="relative z-10 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24 md:pt-16 md:pb-32">
      <div class="text-center">
        <!--<span class="inline-flex items-center justify-center bg-white rounded-full shadow-2xl mb-8 w-56 h-56 md:w-72 md:h-72 overflow-hidden p-6 md:p-8">-->
        <span class="inline-flex items-center justify-center rounded-full mb-8 w-76 h-76 md:w-92 md:h-92 overflow-hidden p-6 md:p-8">
          <Image
            src={u('/images/logo-no-bg-white.png')}
            alt="Natalie Chapman Piano Studio"
            width={1920}
            height={1080}
            class="w-full h-auto"
          />
        </span>
        <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-4">Orewa, Auckland · All Ages Welcome</p>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          Creative, flexible and <em>fun</em>!<br />Come join the music journey!
        </h1>
        <p class="text-lg text-white/90 mb-8 leading-relaxed max-w-xl mx-auto">
          Piano lessons tailored to your goals and interests, from a teacher who genuinely loves music and loves sharing it.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href={u('/contact')}
            class="inline-flex items-center px-6 py-3 rounded-lg font-semibold text-ink bg-white hover:bg-brand-light transition-colors"
          >
            Book a Lesson
          </a>
          <a
            href={u('/about')}
            class="inline-flex items-center px-6 py-3 rounded-lg font-semibold text-white bg-white/50 border border-white/40 hover:bg-white/90 transition-colors"
          >
            Meet Natalie
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Makes Us Different -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">The Studio Difference</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-4">
          What Makes Our Studio Different
        </h2>
        <p class="text-ink-muted max-w-2xl mx-auto leading-relaxed">
          Forget rigid curriculums and cookie-cutter lessons. Here, your goals and interests lead the way.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {differentiators.map(item => (
          <div class="bg-white rounded-2xl p-6 border border-linen hover:shadow-md transition-shadow flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-brand-light flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
              </div>
              <h3 class="font-semibold text-ink">{item.title}</h3>
            </div>
            <p class="text-sm text-ink-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- In the Studio -->
  <section class="bg-cream-dark py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">

        <div class="flex justify-center">
          <Image
            src={u('/images/studio-interior.jpg')}
      width=690
      height=920
            alt="Student at the piano in Natalie's home studio"
            class="w-3/5 h-auto rounded-2xl shadow-xl"
          />
        </div>

        <div class="md:pt-8">
          <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">The Studio</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-6">
            A Space Where Music Comes Alive
          </h2>
          <p class="text-ink-muted leading-relaxed mb-6">
            Natalie's warm home studio in Orewa is set up specifically for learning - with sheet music, educational materials, and a quality piano that students look forward to playing every week.
          </p>
          <ul class="space-y-3 mb-8">
            {[
              'Welcoming home studio in Orewa, Auckland',
              'Online lessons via Zoom for students further afield',
              'All lesson materials and resources provided',
              'Flexible scheduling around your family',
            ].map(item => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-brand shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-ink-muted text-sm">{item}</span>
              </li>
            ))}
          </ul>
          <a
            href={u('/contact')}
            class="inline-flex items-center px-6 py-3 rounded-lg font-semibold text-white bg-brand hover:bg-brand-dark transition-colors"
          >
            Book a Lesson
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet the Teacher -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

        <div>
          <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">Your Teacher</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-6">
            Meet Natalie Chapman
          </h2>
          <p class="text-ink-muted leading-relaxed mb-4">
            Natalie is a lifelong musician with over 30 years of experience across classical, contemporary, and jazz styles. She earned her Trinity College Grade 8 at 15 and completed the IRMT diploma <em>with distinction</em> after launching her teaching practice in 2018.
          </p>
          <p class="text-ink-muted leading-relaxed mb-6">
            Her studio has grown almost entirely through word-of-mouth - the best endorsement of all.
          </p>
          <p class="font-display text-xl text-brand italic mb-8">"Let's Love Music Together!"</p>
          <a href={u('/about')} class="inline-flex items-center gap-2 text-brand font-semibold hover:text-brand-dark transition-colors">
            Read more about Natalie
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="flex justify-center">
          <div class="relative">
            <div class="w-72 h-72 md:w-80 md:h-80 rounded-full overflow-hidden border-4 border-white shadow-xl">
              <Image
                src={u('/images/natalie-portrait.png')}
      width=622
      height=488
                alt="Natalie Chapman, piano teacher"
                class="w-full h-full object-cover object-top"
              />
            </div>
            <div class="absolute -bottom-4 -right-4 bg-brand text-white text-xs font-semibold px-4 py-2 rounded-full shadow-lg whitespace-nowrap">
              Teaching since 2018
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-cream-dark py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">

        <div class="lg:col-span-3">
          <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">Testimonials</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-8">
            What Students &amp; Parents Say
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {testimonials.map(t => (
              <div class="bg-white rounded-2xl p-5 border border-linen flex flex-col">
                <svg class="w-7 h-7 text-brand mb-3 shrink-0" fill="currentColor" viewBox="0 0 32 32">
                  <path d="M10 8C6.686 8 4 10.686 4 14v10h10V14H7c0-1.654 1.346-3 3-3V8zm18 0c-3.314 0-6 2.686-6 6v10h10V14h-7c0-1.654 1.346-3 3-3V8z" />
                </svg>
                <p class="text-ink-muted text-sm leading-relaxed flex-grow italic mb-4">"{t.quote}"</p>
                <div>
                  <p class="font-semibold text-ink text-sm">{t.name}</p>
                  <p class="text-xs text-ink-muted">{t.role}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="lg:col-span-2 flex justify-center lg:justify-end">
          <div class="rounded-2xl overflow-hidden shadow-xl w-full max-w-xs">
            <Image
              src={u('/images/students.jpg')}
      width=690
      height=920
              alt="Happy piano students holding musical note cookies"
              class="w-full h-auto"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-cream-dark py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-4">
        Ready to Start Your Music Journey?
      </h2>
      <p class="text-ink-muted max-w-xl mx-auto mb-8 leading-relaxed">
        Get in touch to ask a question or book your first lesson. No pressure - just music.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={u('/contact')}
          class="px-6 py-3 rounded-lg font-semibold text-white bg-brand hover:bg-brand-dark transition-colors"
        >
          Get in Touch
        </a>
        <a
          href={u('/faq')}
          class="px-6 py-3 rounded-lg font-semibold text-brand border border-brand/30 hover:bg-brand-light transition-colors"
        >
          Read the FAQ
        </a>
      </div>
    </div>
  </section>

</Layout>
