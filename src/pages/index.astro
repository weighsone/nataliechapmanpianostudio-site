---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;

const testimonials = [
  {
    quote: 'She has always been very flexible around lessons so that it fits in with our busy lives.',
    name: 'Suyen',
    role: 'Parent',
  },
  {
    quote: 'My son always comes home after a lesson buzzing — I wish I could say the same about school!',
    name: 'Heidi',
    role: 'Parent',
  },
  {
    quote: 'She makes learning the piano fun and uncomplicated.',
    name: 'Jasper',
    role: 'Student',
  },
  {
    quote: 'She proactively finds ways to engage her students by exploring their interests.',
    name: 'Carmela',
    role: 'Parent',
  },
];

const differentiators = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />`,
    title: 'Tailored to You',
    body: 'No one-size-fits-all approach here. Every lesson is designed around your goals, learning style, and musical interests.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />`,
    title: 'Your Style of Music',
    body: "Classical, pop, jazz, church band — we follow your passion. Loving what you play is the best motivator.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    title: 'Flexible Scheduling',
    body: 'Life is busy. Lessons fit around your family, work, and commitments — not the other way around.',
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    title: 'Positive & Encouraging',
    body: 'Music should be joyful. The studio is a warm, pressure-free space where every student feels celebrated.',
  },
];
---

<Layout title="Home" description="Creative, flexible and fun piano lessons in Orewa, Auckland. All ages and levels welcome. Book a lesson with Natalie Chapman today.">

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-purple-dark via-purple to-purple-light/30 text-white">
    <!-- Piano keys decorative strip -->
    <div class="absolute bottom-0 left-0 right-0 flex h-20 opacity-10 pointer-events-none" aria-hidden="true">
      {Array.from({ length: 28 }).map((_, i) => (
        <div class={`flex-1 border-r border-white/30 ${[1,4,6,9,11,13,16,18,21,23,25].includes(i % 14) ? 'bg-black h-12 self-start' : 'bg-white'}`} />
      ))}
    </div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-36">
      <div class="max-w-2xl">
        <p class="text-gold text-sm font-semibold tracking-widest uppercase mb-4">Orewa, Auckland · All Ages Welcome</p>
        <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          Creative, flexible<br />and <em>fun</em> — come<br />join the music journey!
        </h1>
        <p class="text-lg text-white/80 mb-8 leading-relaxed">
          Piano lessons tailored to your goals and interests, from a teacher who genuinely loves music and loves sharing it.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href={u('/contact')}
            class="inline-flex items-center px-6 py-3 rounded-lg font-semibold text-purple bg-white hover:bg-cream-dark transition-colors"
          >
            Book a Free Intro Lesson
          </a>
          <a
            href={u('/about')}
            class="inline-flex items-center px-6 py-3 rounded-lg font-semibold text-white border border-white/40 hover:bg-white/10 transition-colors"
          >
            Meet Natalie
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Makes Us Different -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-purple text-sm font-semibold tracking-widest uppercase mb-3">The Studio Difference</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-4">
          What Makes Our Studio Different
        </h2>
        <p class="text-ink-muted max-w-2xl mx-auto leading-relaxed">
          Forget rigid curriculums and cookie-cutter lessons. Here, your goals and interests lead the way.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {differentiators.map(item => (
          <div class="bg-white rounded-2xl p-6 border border-linen hover:shadow-md transition-shadow">
            <div class="w-10 h-10 rounded-xl bg-purple-light flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
            </div>
            <h3 class="font-semibold text-ink mb-2">{item.title}</h3>
            <p class="text-sm text-ink-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Meet the Teacher -->
  <section class="bg-cream-dark py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-purple text-sm font-semibold tracking-widest uppercase mb-3">Your Teacher</p>
          <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-6">
            Meet Natalie Chapman
          </h2>
          <p class="text-ink-muted leading-relaxed mb-4">
            Natalie is a lifelong musician raised by two musical parents. She began formal piano training at age five and earned her Trinity College Grade 8 certification at 15. With over 30 years of experience across classical, contemporary, and jazz styles, she brings a deep and genuine love of music to every lesson.
          </p>
          <p class="text-ink-muted leading-relaxed mb-6">
            Since launching her teaching practice in 2018 and completing the Institute of Registered Music Teachers (IRMT) diploma <em>with distinction</em>, her studio has grown almost entirely through word-of-mouth — the best endorsement of all.
          </p>
          <p class="font-display text-xl text-purple italic mb-8">"Let's Love Music Together!"</p>
          <a href={u('/about')} class="inline-flex items-center gap-2 text-purple font-semibold hover:text-purple-dark transition-colors">
            Read more about Natalie
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="bg-white rounded-2xl p-8 border border-linen">
          <h3 class="font-display text-xl font-semibold text-ink mb-6">Studio at a Glance</h3>
          <ul class="space-y-4">
            {[
              ['Location', 'Orewa, Auckland (+ online lessons)'],
              ['Teaching since', '2018'],
              ['Qualification', 'IRMT Diploma — with distinction'],
              ['Trinity College', 'Grade 8 certified'],
              ['Styles', 'Classical, contemporary, jazz, pop, church'],
              ['Ages', 'All ages from around 5 years'],
            ].map(([label, value]) => (
              <li class="flex gap-3">
                <span class="w-2 h-2 rounded-full bg-gold mt-2 shrink-0" />
                <div>
                  <span class="text-xs text-ink-muted uppercase tracking-wide block">{label}</span>
                  <span class="text-sm text-ink font-medium">{value}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-purple text-sm font-semibold tracking-widest uppercase mb-3">Testimonials</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-ink">
          What Students & Parents Say
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {testimonials.map(t => (
          <div class="bg-white rounded-2xl p-6 border border-linen flex flex-col">
            <svg class="w-8 h-8 text-gold mb-4 shrink-0" fill="currentColor" viewBox="0 0 32 32">
              <path d="M10 8C6.686 8 4 10.686 4 14v10h10V14H7c0-1.654 1.346-3 3-3V8zm18 0c-3.314 0-6 2.686-6 6v10h10V14h-7c0-1.654 1.346-3 3-3V8z" />
            </svg>
            <p class="text-ink-muted text-sm leading-relaxed flex-grow italic mb-6">
              "{t.quote}"
            </p>
            <div>
              <p class="font-semibold text-ink text-sm">{t.name}</p>
              <p class="text-xs text-ink-muted">{t.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-gold-light border-y border-linen py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-ink mb-4">
        Ready to Start Your Music Journey?
      </h2>
      <p class="text-ink-muted max-w-xl mx-auto mb-8 leading-relaxed">
        Get in touch to book a free introductory lesson. No pressure — just music.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={u('/contact')}
          class="px-6 py-3 rounded-lg font-semibold text-white bg-purple hover:bg-purple-dark transition-colors"
        >
          Get in Touch
        </a>
        <a
          href={u('/faq')}
          class="px-6 py-3 rounded-lg font-semibold text-purple border border-purple hover:bg-purple-light transition-colors"
        >
          Read the FAQ
        </a>
      </div>
    </div>
  </section>

</Layout>
