---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (path: string) => `${base}${path}`;

const faqs = [
  {
    category: 'Getting Started',
    items: [
      {
        q: 'What ages do you teach?',
        a: 'All ages! I welcome students from around 5-6 years old through to adults and seniors. It is truly never too late to start learning piano. Adult beginners are warmly encouraged.',
      },
      {
        q: 'Is there a minimum age to start?',
        a: 'I generally start teaching children from around age 5, depending on their developmental readiness. For younger children, I offer a free introductory session to see whether they are ready to begin piano lessons.',
      },
      {
        q: 'Do I need any experience to start?',
        a: 'Not at all. Complete beginners are very welcome. In your first lesson we will cover the basics together and talk about your musical goals so I can tailor lessons to you from day one.',
      },
      {
        q: 'My child is very young - when is the right time to start?',
        a: 'I generally recommend starting formal lessons from around age 5-6, when fine motor skills and the ability to focus for 30 minutes are well developed. For younger children, encouraging music through singing, listening, and playing games at home is a great first step. Feel free to get in touch and we can chat about what is right for your child.',
      },
      {
        q: 'Will I need to buy a book?',
        a: 'Most students will work through a series of method books, and these can either be purchased through me, or once we have discussed which would be most appropriate you can source these yourself. Some suggestions of places to buy these books can be found on the resources page.',
      },
    ],
  },
  {
    category: 'Lessons & Scheduling',
    items: [
      {
        q: 'How long are lessons?',
        a: 'Lessons are 30 minutes long. Longer lessons may be recommended as students advance.',
      },
      {
        q: 'How much do lessons cost?',
        a: 'Half an hour of private piano tuition is $40, or $75 for an hour.',
      },
      {
        q: 'Where are lessons held?',
        a: 'Lessons are held in my home teaching studio in Orewa, Auckland. Parking is available on the street.',
      },
      {
        q: 'When are lessons held?',
        a: 'Lessons are usually weekly, at the same day and time and run with the school terms. Lessons during school holidays are available by arrangement.',
      },
      {
        q: 'Can I stay?',
        a: 'Parents and caregivers are welcome to stay during lessons if they wish to do so.',
      },
      {
        q: 'How much practice do I need to do?',
        a: 'It is up to you how much you practice, but the more you practice, the more you will improve. Practicing little and often is better than an occasional long practice session.',
      },
      {
        q: 'What if I can\'t make it to my lesson?',
        a: 'If you are unable to attend a lesson, please contact me in advance to see if an alternative time can be arranged. Your regular weekly lesson space cannot be refilled if you do not attend. Please refer to the Studio Policy for more details on make-up lessons and cancellations.',
      },
    ],
  },
  {
    category: 'Equipment & Pricing',
    items: [
      {
        q: 'What equipment do I need at home?',
        a: 'At minimum, a digital keyboard with at least 61 weighted keys and a sustain pedal is recommended. A full 88-key weighted digital piano is ideal for more advanced playing. I am happy to advise on suitable instruments if you need help choosing.',
      },
      {
        q: 'Will I need my own keyboard?',
        a: 'Yes. You will need your own piano or keyboard to practice on at home. I can recommend suitable second-hand options and local retailers.',
      },
    ],
  },
  {
    category: 'Music & Curriculum',
    items: [
      {
        q: 'What styles of music will I learn?',
        a: 'This is your musical journey - we follow your interests! Whether you want to explore classical repertoire, contemporary pop, jazz, gospel, worship music, or a mix of everything, lessons are tailored to what excites you. There is no rigid syllabus here.',
      },
      {
        q: 'Do you prepare students for music exams?',
        a: 'Yes! I prepare students for Trinity College London graded exams and can also work towards ABRSM examinations. Exams are entirely optional, and many students prefer to focus on music they love without the pressure of formal assessment.',
      },
      {
        q: 'Will I learn music theory as well as playing?',
        a: 'Yes - understanding music theory is woven into lessons naturally. Things like reading notation, understanding rhythm, and basic harmony are introduced progressively and in a way that makes sense in the context of the music you are learning.',
      },
    ],
  },
];
---

<Layout
  title="FAQ"
  description="Frequently asked questions about piano lessons at Natalie Chapman Piano Studio - lesson lengths, pricing, ages, styles, exams, and more."
>

  <!-- Page Header -->
  <section class="relative overflow-hidden text-white py-16 md:py-24">
    <div class="fixed inset-0 -z-10 w-screen h-screen">
      <Image
        src={u('/images/piano-hero.jpg')}
        alt=""
        width={1920}
        height={1440}
        class="w-full h-full object-cover object-[50%_60%]"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-black/30"></div>
    </div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-brand text-sm font-semibold tracking-widest uppercase mb-3">Common Questions</p>
        <h1 class="font-display text-4xl md:text-5xl font-bold mb-4">Frequently Asked Questions</h1>
        <p class="text-white/90 max-w-xl mx-auto leading-relaxed">
          Everything you need to know before getting started. Can't find your answer? <a href={u('/contact')} class="underline hover:text-brand transition-colors">Get in touch</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ content -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-14">
        {faqs.map(group => (
          <div>
            <h2 class="font-display text-xl font-semibold text-ink mb-6 pb-3 border-b border-linen">
              {group.category}
            </h2>
            <div class="space-y-0 divide-y divide-linen">
              {group.items.map(item => (
                <details class="group py-5">
                  <summary class="flex justify-between items-start gap-4 cursor-pointer list-none">
                    <span class="font-semibold text-ink group-open:text-brand transition-colors">{item.q}</span>
                    <svg
                      class="w-5 h-5 text-ink-muted shrink-0 mt-0.5 transition-transform group-open:rotate-180"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <p class="mt-4 text-ink-muted leading-relaxed">{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Still have questions -->
  <section class="bg-cream-dark py-16 border-t border-linen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink mb-4">Still have questions?</h2>
      <p class="text-ink-muted mb-8 max-w-md mx-auto">
        I am always happy to chat before you commit to anything. Send me a message and I will get back to you.
      </p>
      <a
        href={u('/contact')}
        class="inline-flex items-center px-6 py-3 rounded-lg font-semibold text-white bg-brand hover:bg-brand-dark transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </section>

</Layout>
